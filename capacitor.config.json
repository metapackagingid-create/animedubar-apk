{
  "appId": "com.animedubar.app",
  "appName": "Animedubar",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://metapackagingid-create.github.io/animedubar-apk/",
    "cleartext": true,
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "*.github.io",
      "*.pages.dev"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FFFFFF"
    }
  }
}